{
  "name": "square-sdk-cli",
  "version": "0.2.0",
  "description": "Command-line interface for the Square API, exposing every SDK namespace and method via runtime introspection.",
  "keywords": [
    "square",
    "square-api",
    "square-sdk",
    "cli",
    "payments",
    "checkout",
    "bun",
    "sdk"
  ],
  "module": "bin/square.ts",
  "type": "module",
  "license": "MIT",
  "author": "karthikdilliraj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikdilliraj/square-sdk-cli.git"
  },
  "homepage": "https://github.com/karthikdilliraj/square-sdk-cli#readme",
  "bugs": "https://github.com/karthikdilliraj/square-sdk-cli/issues",
  "bin": {
    "square": "dist/square.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "square": "^44.2.1"
  }
}
